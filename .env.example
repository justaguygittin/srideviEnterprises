# =========================================================
# Project : Sridevi Enterprises
# File    : .env.example
# Purpose : Template for the environment variables config.py
#           loads via python-dotenv. Copy this to .env and
#           fill in real values. Never commit the real .env.
# =========================================================

# Database connection (MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Flask session/signing secret. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Must be "False" in production. Only set to "True" for local development.
FLASK_DEBUG=False

# Send the session cookie only over HTTPS. Defaults to True when unset.
#
# LOCAL DEVELOPMENT runs over plain http://127.0.0.1:5000, where a secure
# cookie is refused by the browser and employee login will not work at all -
# so this template ships False. This is the one value in this file that is
# LESS safe than the application's own default.
#
# PRODUCTION MUST set this to True, or simply delete the line (True is the
# default). The deployed site is HTTPS-only. The application logs a WARNING on
# every startup while this is False, so check the error log after deploying.
SESSION_COOKIE_SECURE=False

# Application log verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# Defaults to INFO, which records every write operation and every failure
# without logging a line per page view. Set to WARNING to keep only problems.
# Logs are written to stderr, which Passenger captures into the error log
# linked from cPanel's "Setup Python App" page. An unrecognised value falls
# back to INFO rather than preventing the site from starting.
LOG_LEVEL=INFO

# DEPRECATED - the Invoice Generator is now a module of this application
# (routes/receipts.py), not a separate project it links out to. Nothing
# reads this any more; safe to delete from a deployment's real .env.
# INVOICE_GENERATOR_URL=
# RECEIPT_GENERATOR_URL=

# =========================================================
# Invoice Generator seller details (Invoice Generator Module)
#
# Printed on every generated invoice. The seller's address/phone are NOT
# set here - the invoice reuses BUSINESS_ADDRESS/BUSINESS_PHONE below.
# Optional: leaving these blank does not stop the site from starting, but
# services/gst_service.py refuses to generate an invoice without a seller
# GSTIN configured.
#
# The values below are FAKE PLACEHOLDERS (same rule as the business
# details further down). Put the real GSTIN and bank details only in the
# real .env, never in this committed template.
# =========================================================
SELLER_GSTIN=00AAAAA0000A0Z0
SELLER_BANK_ACCOUNT=00000000000
SELLER_BANK_NAME=Example Bank - Example Branch
SELLER_IFSC=EXMP0000000

# =========================================================
# Public business details (v1.0)
#
# The showroom's real-world contact information. These are the ONLY place
# these details are defined - they are rendered on every public surface
# that shows them: the sitewide footer, the Contact page, and the
# standalone Maintenance Mode (503) screen.
#
# PRODUCTION: replace every value below with the real business details in
# the server's own .env file (created during deployment - see
# DEPLOYMENT.md section 1.5). This file is only a template and is never
# read by the application at runtime.
#
# The values below are DEVELOPMENT PLACEHOLDERS. They exist so a fresh
# local checkout renders a complete page. They must never reach a
# production .env.
#
# Any value may be left blank. A blank value is not an error: the line is
# simply omitted from every page, so a deployment that has not yet been
# given real details shows nothing rather than fake contact information.
# =========================================================

# Full showroom address, on one line, as it should read on the page.
BUSINESS_ADDRESS=123 Business Road, Example City, ST 000000

# Written for display. The dialable tel: link is derived automatically
# (spaces and punctuation are stripped), so no second variable is needed.
BUSINESS_PHONE=+91 98765 43210

# Public enquiry email. Used as-is for the mailto: link.
BUSINESS_EMAIL=info@sridevienterprises.example

# Public website, written for display. A https:// prefix is added
# automatically when building the link if you omit the scheme.
BUSINESS_WEBSITE=www.sridevienterprises.example

# Opening hours, as free text.
BUSINESS_HOURS=Monday-Saturday, 9:00 AM-6:00 PM

# =========================================================
# WhatsApp click-to-chat
#
# The number customers reach through the floating WhatsApp button and the
# "Enquire on WhatsApp" button on each product page. This is the ONLY
# place the number is set; replacing it later (e.g. with a dedicated
# business number) is an edit to this one line plus a restart.
#
# Write it in international format WITH the leading + and country code:
#   WHATSAPP_BUSINESS_NUMBER=+91 XXXXX XXXXX
# Spaces, dashes and brackets are fine. A number without the leading +
# is rejected, because without a country code the link would open a chat
# with the wrong person.
#
# Left blank (as shipped here) or invalid, every WhatsApp button is hidden
# and no wa.me link is rendered. Deliberately no placeholder number: a
# fake one would be a working link to a stranger.
#
# The number is not written into any page: the buttons link to this site's
# own /whatsapp routes, which redirect to WhatsApp on click. Anyone who
# clicks a button still sees the number (in the redirect and in WhatsApp).
# =========================================================
WHATSAPP_BUSINESS_NUMBER=

# Optional. Prefilled text for the floating button; the customer can edit
# it before sending. Leave blank to use the built-in greeting.
WHATSAPP_DEFAULT_MESSAGE=

# =========================================================
# Password Management - reset emails
#
# PUBLIC_BASE_URL is the site's public address; every password-reset link
# is built from it (never from the request's Host header). In production it
# MUST start with https:// - reset emails are refused otherwise. Local
# development may use http://127.0.0.1:5000.
#
# SMTP settings for outgoing mail. On HostyCare/cPanel create a mailbox
# under "Email Accounts" (e.g. no-reply@your-domain) and use:
#   SMTP_HOST=mail.your-domain   SMTP_PORT=465  SMTP_USE_SSL=True  SMTP_USE_TLS=False
# or
#   SMTP_HOST=mail.your-domain   SMTP_PORT=587  SMTP_USE_SSL=False SMTP_USE_TLS=True
#
# Leave SMTP_HOST blank to disable password recovery by email: the Forgot
# Password page then says recovery is unavailable. Nothing else is affected.
# Put the real mailbox password ONLY in the server's real .env.
# =========================================================
PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_TLS=True
SMTP_USE_SSL=False
