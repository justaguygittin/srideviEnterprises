# =========================================================
# Project : Sridevi Enterprises
# File    : .env.example
# Purpose : Template for the environment variables config.py
#           loads via python-dotenv. Copy this to .env and
#           fill in real values. Never commit the real .env.
# =========================================================

# Database connection (MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Flask session/signing secret. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Must be "False" in production. Only set to "True" for local development.
FLASK_DEBUG=False

# Base URL of the separately-hosted invoice-generation project, shown to
# employees as "Invoice Generator" (optional). Leave unset/blank to show a
# graceful "unavailable" message in the Employee Portal instead of a broken
# link. Example: https://invoices.sridevienterprises.com
INVOICE_GENERATOR_URL=

# Deprecated alias for INVOICE_GENERATOR_URL above, still read as a fallback
# for backward compatibility with existing deployments. Prefer the new name.
# RECEIPT_GENERATOR_URL=
