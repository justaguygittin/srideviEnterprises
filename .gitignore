# ==========================================================
# Project : Sridevi Enterprises
# Purpose : Git Ignore
# Author  : Srikar
# ==========================================================

# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual Environment
# venv*/ (not just venv/) so an alternate/rebuilt environment - e.g. venv312/,
# created when a different Python version was needed locally - is never
# accidentally staged. A venv is machine-specific either way; none of them
# belong in the repo regardless of what they're named.
venv*/
.env

# Local ad-hoc test output - not a project asset. If a real Playwright/PDF
# smoke-test script becomes a permanent part of the repo, name its output
# something that doesn't collide with this pattern.
playwright_test.pdf

# Maintenance Mode - live server state, never committed. See
# config/maintenance.example.json for the template.
config/maintenance.json

# VS Code
.vscode/

# Flask
instance/
*.db

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Uploaded Files
static/uploads/

# Python Cache
.pytest_cache/
.mypy_cache/

# Build
dist/
build/
